# OpenAI-compatible endpoint for the in-app AI actions. Leave empty to disable AI.
LLM_API_BASEURL=
LLM_API_KEY=
LLM_MODEL=

# Postgres password for docker-compose.yml.
GREYDOC_POSTGRES_PASSWORD=

# OIDC sign-in, for example with authentik. Empty issuer means local mode.
GREYDOC_BASE_URL=
GREYDOC_OIDC_ISSUER=
GREYDOC_OIDC_CLIENT_ID=
GREYDOC_OIDC_CLIENT_SECRET=
GREYDOC_ADMIN_GROUP=
